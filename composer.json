{
    "name": "didww/didww-api-3-php-sdk",
    "description": "PHP SDK for DIDWW API 3",
    "type": "library",
    "license": "MIT",
    "authors": [
      {
        "name": "Igor Gonchar",
        "email": "igor.g@didww.com"
      },
      {
        "name": "Igor Fedoronchuk",
        "email": "igor.f@didww.com"
      }
    ],
    "require": {
      "php": ">=8.2",
      "swisnl/json-api-client": "^2.0",
      "guzzlehttp/guzzle": "^8.0.1",
      "phpseclib/phpseclib": "^3.0.7",
      "ext-openssl": "*",
      "ext-curl": "*",
      "ext-json": "*",
      "ext-zlib": "*",
      "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
      "phpunit/phpunit": "^10.5|^11.5",
      "php-vcr/php-vcr": "^1.4",
      "friendsofphp/php-cs-fixer": "^3.45",
      "psr/simple-cache": "^3.0"
    },
    "suggest": {
      "psr/simple-cache": "To share access tokens between processes (PHP-FPM workers, queue workers) through Didww\\Auth\\Psr16TokenStore"
    },
    "autoload": {
      "psr-4": {
        "Didww\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4" : {
        "Didww\\Tests\\" : "tests/"
      }
    },
    "scripts": {
      "test": "XDEBUG_MODE=coverage phpunit --coverage-clover build/logs/clover.xml",
      "check-style": "php-cs-fixer fix --dry-run -v",
      "fix-style": "php-cs-fixer fix"
    },
    "config": {
      "allow-plugins": {
        "php-http/discovery": true
      },
      "audit": {
        "ignore": ["PKSA-5jz8-6tcw-pbk4", "PKSA-z3gr-8qht-p93v"]
      }
    }
}
